<div class="searchBar">
  <div class="container">
    <form action="/search" class="search_form" role="search" method="POST">
        <input 
        type="search" 
        aria-label="Search" 
        id="inputSearch" 
        name="searchTerm" 
        placeholder="Search this site..."
        />
    </form>
    <div id="searchClose">Close</div>
  </div>
</div>  
